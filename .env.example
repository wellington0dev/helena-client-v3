# Porta do servidor local (endpoints internos: /health, /cli-session, /ws
# de status dos canais — ver client/docs/local-server-api.md). Painel web
# desabilitado; a CLI (`helena`) fala com esta porta sozinha.
CLIENT_PANEL_PORT=4100

# URL do backend-v2.
BACKEND_V2_URL=http://localhost:3001

# Token de API de longa duração (WhatsApp/Telegram/execução remota) —
# OPCIONAL: normalmente nem precisa preencher, é gerado sozinho no
# primeiro login (painel ou `helena` CLI) e guardado em
# ~/.config/helena/device-token.json. Só preencha aqui se quiser fixar um
# token específico (ex: reusar entre reinstalações).
BACKEND_V2_API_TOKEN=

# Diretório onde a sessão pareada do WhatsApp é salva.
WHATSAPP_AUTH_DIR=./.whatsapp-auth

# Arquivo onde os pins lid→telefone aprendidos são guardados (ver
# channels/whatsapp.ts) — raramente precisa mudar.
WHATSAPP_LID_PINS_FILE=./.whatsapp-lid-pins.json

# Token do bot do Telegram (via @BotFather) — opcional, sem ele o Telegram
# só fica "desconectado" no painel, sem afetar o WhatsApp.
TELEGRAM_BOT_TOKEN=

# Teto (minutos) de um comando `shell` rodado com `background:true` pela
# Helena — bem maior que os 30s do modo síncrono normal, mas não infinito.
CLIENT_BACKGROUND_SHELL_TIMEOUT_MINUTES=30
