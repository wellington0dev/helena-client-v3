{
  "name": "helena-client",
  "version": "0.1.0",
  "description": "Aplicativo desktop da Helena com interface web no Chromium do Electron e backend Express local.",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "helena": "./bin/helena.js"
  },
  "scripts": {
    "start": "node scripts/build-desktop-daemon.mjs && concurrently -k \"npm --prefix ../helena-web-v3 start -- --host 127.0.0.1 --port 4200\" \"wait-on http://127.0.0.1:4200 && electron electron/main.cjs --dev\"",
    "build": "node scripts/build-desktop-daemon.mjs && node scripts/build-desktop-ui.mjs && electron-builder",
    "test": "node scripts/build-desktop-ui.mjs && node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "sass": "^1.108.2",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@grammyjs/files": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "6.7.24",
    "chalk": "^6.0.0",
    "express": "^5.3.0",
    "grammy": "^1.46.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "string-width": "^8.2.0",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "libsignal": "6.0.0"
  },
  "allowScripts": {
    "baileys@6.7.24": true,
    "protobufjs@7.6.6": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.helena.client",
    "productName": "Helena",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "desktop-ui/dist/**/*",
      "dist-desktop/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
