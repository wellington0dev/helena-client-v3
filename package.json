{
  "name": "helena-client",
  "version": "0.1.0",
  "description": "Serviço local da Helena — substitui o cli/ como dono da configuração de canais (WhatsApp/Telegram) e da conexão com o backend-v2. Sobe um painel web local (QR do WhatsApp no navegador, status dos canais) e faz a ponte de mensagens com o servidor. Ver docs/architecture-v2.md §4.",
  "type": "module",
  "bin": {
    "helena": "./bin/helena.js"
  },
  "scripts": {
    "start": "node src/main.ts",
    "build:panel": "npm --prefix panel-app install && npm --prefix panel-app run build",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "service:install:windows": "node scripts/install-windows-service.js",
    "service:uninstall:windows": "node scripts/uninstall-windows-service.js"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/ws": "^8.5.13",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@grammyjs/files": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "6.7.24",
    "chalk": "^6.0.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.46.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "string-width": "^8.2.0",
    "wrap-ansi": "^10.0.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "libsignal": "6.0.0"
  },
  "allowScripts": {
    "baileys@6.7.24": true,
    "protobufjs@7.6.6": true
  }
}
